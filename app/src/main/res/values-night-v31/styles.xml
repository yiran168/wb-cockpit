<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101219</item>
        <item name="android:navigationBarColor">#191C26</item>
        <item name="android:colorAccent">#8B8CF6</item>
        <item name="android:windowSplashScreenBackground">#101219</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
    </style>

    <style name="SplashTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">#101219</item>
        <item name="android:navigationBarColor">#191C26</item>
        <item name="android:windowSplashScreenBackground">#101219</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
</resources>
